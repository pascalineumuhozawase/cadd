# Dataset files (often large or restricted)
datasets/
dataset/
data/raw/
*.tfrecord
*.zip

# Uploaded user images
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE settings
.vscode/
.idea/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Docker overrides and local secrets
docker-compose.override.yml
docker-compose.*.local.yml

# Local database backups
*.sql.gz
*.dump
*.backup
